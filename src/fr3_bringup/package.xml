<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fr3_bringup</name>
  <version>0.0.1</version>
  <description>
    Top-level launch files for the FR3 manipulation stack.
    Combines Gazebo simulation, MoveIt 2, and task execution.
  </description>
  <maintainer email="you@example.com">Shivaprasad</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fr3_simulation</exec_depend>
  <exec_depend>fr3_moveit_config</exec_depend>
  <exec_depend>fr3_manipulation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>