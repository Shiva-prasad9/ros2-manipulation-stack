<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fr3_simulation</name>
  <version>0.0.1</version>
  <description>
    Gazebo Harmonic simulation worlds and launch files for the FR3 arm.
    Handles world loading, robot spawning, and robot_state_publisher bringup.
  </description>
  <maintainer email="you@example.com">Shivaprasad</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <!-- franka_description: provides the FR3 xacro/URDF and meshes -->
  <exec_depend>franka_description</exec_depend>

  <!-- robot_state_publisher: broadcasts TF from joint states + URDF -->
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- ros_gz_sim: provides the 'create' spawner node for Gazebo -->
  <exec_depend>ros_gz_sim</exec_depend>

  <!-- xacro: needed to process .urdf.xacro files at launch time -->
  <exec_depend>xacro</exec_depend>

  <exec_depend>ros_gz_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
